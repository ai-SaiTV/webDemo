{
    "$schema": "./tsconfig.schema.json",
    "files": [],
    "references": [
      { "path": "./tsconfig.app.json" },
      { "path": "./tsconfig.node.json" }
    ],
    "compilerOptions": {
      "moduleResolution": "node",
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
      "baseUrl": ".",
      "paths": {
        "@/*": [
          "src/*"
        ]
      },
      "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "/src/types/**/*.d.ts"
  ]
}
  